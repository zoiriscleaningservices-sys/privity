# Privity API Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://privity:privity_secure_password@localhost:5432/privity_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Secrets
JWT_SECRET="privity_super_secret_jwt_access_token_key_change_in_prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="privity_super_secret_jwt_refresh_token_key_change_in_prod"
JWT_REFRESH_EXPIRES_IN="30d"

# AWS & CloudFront Media Services
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test_access_key"
AWS_SECRET_ACCESS_KEY="test_secret_key"
S3_BUCKET="privity-media-storage-dev"
CLOUDFRONT_DOMAIN="https://cdn.privity.internal"

# Third Party Integrations
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
ALGOLIA_APP_ID=""
ALGOLIA_API_KEY=""
SENTRY_DSN=""
