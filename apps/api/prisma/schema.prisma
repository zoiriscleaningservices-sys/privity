datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountPrivacy {
  public
  private
}

enum PostPrivacy {
  public
  followers
  close_friends
}

enum PostType {
  text
  image
  video
}

enum UserRole {
  visitor
  user
  creator
  moderator
  admin
}

enum FollowStatus {
  pending
  accepted
}

enum ReportTargetType {
  user
  post
  comment
}

enum ReportStatus {
  open
  under_review
  resolved
}

enum ReportPriority {
  low
  medium
  high
  urgent
}

enum MediaJobStatus {
  queued
  processing
  completed
  failed
}

model User {
  id              String         @id @default(uuid())
  username        String         @unique
  email           String         @unique
  phone           String?
  passwordHash    String?        @map("password_hash")
  displayName     String         @map("display_name")
  bio             String?
  avatarUrl       String?        @map("avatar_url")
  privacySetting  AccountPrivacy @default(public) @map("privacy_setting")
  role            UserRole       @default(user)
  isVerified      Boolean        @default(false) @map("is_verified")
  isSuspended     Boolean        @default(false) @map("is_suspended")
  suspendedUntil  DateTime?      @map("suspended_until")
  isBanned        Boolean        @default(false) @map("is_banned")
  pinnedPostId    String?        @map("pinned_post_id")
  settings        Json?          @default("{\"pushEnabled\": true, \"likes\": true, \"comments\": true, \"follows\": true, \"mentions\": true}")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relationships
  posts           Post[]         @relation("UserPosts")
  comments        Comment[]      @relation("UserComments")
  likes           Like[]         @relation("UserLikes")
  saves           Save[]         @relation("UserSaves")
  
  // Follows
  following       Follow[]       @relation("UserFollowing")
  followers       Follow[]       @relation("UserFollowers")
  
  // Close Friends
  closeFriends    CloseFriend[]  @relation("OwnerCloseFriends")
  closeFriendOf   CloseFriend[]  @relation("FriendInCloseFriends")

  // Blocks
  blocking        Block[]        @relation("UserBlocking")
  blockedBy       Block[]        @relation("UserBlockedBy")

  // Notifications
  notifications   Notification[] @relation("UserNotifications")

  // Reports
  filedReports    Report[]       @relation("ReporterUser")
  resolvedReports Report[]       @relation("ResolverUser")
  
  // Audit logs
  auditLogs       AuditLog[]     @relation("ActorAuditLogs")

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Post {
  id             String         @id @default(uuid())
  authorId       String         @map("author_id")
  author         User           @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  type           PostType       @default(text)
  contentUrl     String?        @map("content_url")
  thumbnailUrl   String?        @map("thumbnail_url")
  caption        String         @default("")
  tags           String[]       @default([])
  privacy        PostPrivacy    @default(public)
  visibilityId   String?        @map("visibility_id")
  likesCount     Int            @default(0) @map("likes_count")
  commentsCount  Int            @default(0) @map("comments_count")
  sharesCount    Int            @default(0) @map("shares_count")
  savesCount     Int            @default(0) @map("saves_count")
  scheduledAt    DateTime?      @map("scheduled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  // Relationships
  comments       Comment[]      @relation("PostComments")
  likes          Like[]         @relation("PostLikes")
  saves          Save[]         @relation("PostSaves")
  mediaJobs      MediaProcessingJob[]

  @@index([authorId])
  @@index([createdAt])
  @@index([privacy])
  @@index([deletedAt])
  @@map("posts")
}

model Comment {
  id              String     @id @default(uuid())
  postId          String     @map("post_id")
  post            Post       @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  authorId        String     @map("author_id")
  author          User       @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  text            String
  parentCommentId String?    @map("parent_comment_id")
  parentComment   Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]  @relation("CommentReplies")
  createdAt       DateTime   @default(now()) @map("created_at")
  editedAt        DateTime?  @map("edited_at")
  deletedAt       DateTime?  @map("deleted_at")

  @@index([postId])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("comments")
}

model Follow {
  id          String       @id @default(uuid())
  followerId  String       @map("follower_id")
  follower    User         @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId  String       @map("followee_id")
  followee    User         @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)
  status      FollowStatus @default(accepted)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
  @@map("follows")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id")
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Save {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("UserSaves", fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id")
  post      Post     @relation("PostSaves", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@index([userId])
  @@map("saves")
}

model CloseFriend {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("OwnerCloseFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String   @map("friend_id")
  friend    User     @relation("FriendInCloseFriends", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, friendId])
  @@index([userId])
  @@map("close_friends")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("blocks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String           @map("reporter_id")
  reporter    User             @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  reason      String
  notes       String?
  status      ReportStatus     @default(open)
  priority    ReportPriority   @default(medium)
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")
  resolvedById String?         @map("resolved_by_id")
  resolvedBy  User?            @relation("ResolverUser", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actor      User     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model MediaProcessingJob {
  jobId       String         @id @default(uuid()) @map("job_id")
  postId      String         @map("post_id")
  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceUrl   String         @map("source_url")
  status      MediaJobStatus @default(queued)
  outputUrls  Json?          @map("output_urls")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")

  @@index([postId])
  @@index([status])
  @@map("media_processing_jobs")
}
